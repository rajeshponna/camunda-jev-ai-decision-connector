      </bpmn:userTask>
      <bpmn:userTask id="Peak_Performance" name="Health &#38; Wellness">
        <bpmn:documentation>Peak Performance by Brad Stulberg and Steve Magness. The stress-plus-rest principle for sustainable performance.</bpmn:documentation>
