      <bpmn:outgoing>Flow_13fwgk3</bpmn:outgoing>
      <bpmn:userTask id="Eat_to_Live" name="Health &#38; Wellness">
        <bpmn:documentation>Eat to Live by Joel Fuhrman. A nutrient-dense, plant-heavy eating plan for weight loss and long-term health.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:userTask />
        </bpmn:extensionElements>
      </bpmn:userTask>
      <bpmn:userTask id="Why_We_Sleep" name="Health &#38; Wellness">
        <bpmn:documentation>Why We Sleep by Matthew Walker. The science of sleep and how sleep loss affects the body and mind.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:userTask />
        </bpmn:extensionElements>
      </bpmn:userTask>
      <bpmn:userTask id="The_Obesity_Code" name="Health &#38; Wellness">
        <bpmn:documentation>The Obesity Code by Jason Fung. Argues that insulin, not calories alone, drives weight gain, and covers fasting.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:userTask />
        </bpmn:extensionElements>
      </bpmn:userTask>
      <bpmn:userTask id="Outlive" name="Health &#38; Wellness">
        <bpmn:documentation>Outlive by Peter Attia. Strategies for a longer healthspan through exercise, nutrition, sleep and prevention.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:userTask />
        </bpmn:extensionElements>
      </bpmn:userTask>
      <bpmn:userTask id="How_Not_to_Die" name="Health &#38; Wellness">
        <bpmn:documentation>How Not to Die by Michael Greger. Evidence on how diet can help prevent the leading causes of death.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:userTask />
        </bpmn:extensionElements>
      </bpmn:userTask>
      <bpmn:userTask id="In_Defense_of_Food" name="Health &#38; Wellness">
        <bpmn:documentation>In Defense of Food by Michael Pollan. Simple rules for eating real food instead of processed products.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:userTask />
        </bpmn:extensionElements>
      </bpmn:userTask>
      <bpmn:userTask id="The_Blue_Zones" name="Health &#38; Wellness">
        <bpmn:documentation>The Blue Zones by Dan Buettner. Lifestyle habits of the world's longest-lived communities.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:userTask />
        </bpmn:extensionElements>
      </bpmn:userTask>
      <bpmn:userTask id="Born_to_Run" name="Health &#38; Wellness">
        <bpmn:documentation>Born to Run by Christopher McDougall. The Tarahumara runners and the case for natural running.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:userTask />
        </bpmn:extensionElements>
      </bpmn:userTask>
      <bpmn:userTask id="The_China_Study" name="Health &#38; Wellness">
        <bpmn:documentation>The China Study by T. Colin Campbell. Research linking diet, especially animal protein, with chronic disease.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:userTask />
        </bpmn:extensionElements>
      </bpmn:userTask>
      <bpmn:userTask id="Salt_Sugar_Fat" name="Health &#38; Wellness">
        <bpmn:documentation>Salt Sugar Fat by Michael Moss. How the processed food industry engineers cravings.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:userTask />
        </bpmn:extensionElements>
      </bpmn:userTask>
      <bpmn:userTask id="Grain_Brain" name="Health &#38; Wellness">
        <bpmn:documentation>Grain Brain by David Perlmutter. Argues for links between carbohydrates and brain health.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:userTask />
        </bpmn:extensionElements>
      </bpmn:userTask>
      <bpmn:userTask id="The_Complete_Guide_to_Fasting" name="Health &#38; Wellness">
        <bpmn:documentation>The Complete Guide to Fasting by Jason Fung. A practical guide to intermittent and extended fasting.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:userTask />
        </bpmn:extensionElements>
      </bpmn:userTask>
      <bpmn:userTask id="Breath" name="Health &#38; Wellness">
        <bpmn:documentation>Breath by James Nestor. How breathing techniques affect health and performance.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:userTask />
        </bpmn:extensionElements>
      </bpmn:userTask>
      <bpmn:userTask id="Spark" name="Health &#38; Wellness">
        <bpmn:documentation>Spark by John Ratey. How exercise improves brain function, mood and learning.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:userTask />
        </bpmn:extensionElements>
      </bpmn:userTask>
      <bpmn:userTask id="Deep_Nutrition" name="Health &#38; Wellness">
        <bpmn:documentation>Deep Nutrition by Catherine Shanahan. Traditional diets and their effect on health across generations.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:userTask />
        </bpmn:extensionElements>
      </bpmn:userTask>
      <bpmn:userTask id="The_Omnivore_s_Dilemma" name="Health &#38; Wellness">
        <bpmn:documentation>The Omnivore's Dilemma by Michael Pollan. Traces where our food comes from through four meals.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:userTask />
        </bpmn:extensionElements>
      </bpmn:userTask>
      <bpmn:userTask id="Fast_Food_Nation" name="Health &#38; Wellness">
        <bpmn:documentation>Fast Food Nation by Eric Schlosser. An investigation into the fast food industry and its effects.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:userTask />
        </bpmn:extensionElements>
      </bpmn:userTask>
      <bpmn:userTask id="Good_Calories_Bad_Calories" name="Health &#38; Wellness">
        <bpmn:documentation>Good Calories, Bad Calories by Gary Taubes. A critique of conventional nutrition science on fat and carbohydrates.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:userTask />
        </bpmn:extensionElements>
      </bpmn:userTask>
      <bpmn:userTask id="Why_We_Get_Fat" name="Health &#38; Wellness">
        <bpmn:documentation>Why We Get Fat by Gary Taubes. Argues that carbohydrates drive fat accumulation.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:userTask />
        </bpmn:extensionElements>
      </bpmn:userTask>
      <bpmn:userTask id="Intuitive_Eating" name="Health &#38; Wellness">
