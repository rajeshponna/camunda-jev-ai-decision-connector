{
  "$schema": "https://unpkg.com/@camunda/zeebe-element-templates-json-schema/resources/schema.json",
  "name": "Jev AI Decision Connector",
  "id": "io.github.rajeshponna.jev-ai-decision",
  "version": 5,
  "description": "Fast typed decisions with TypeSafe Jev: pick the best option, find all matches, or ask noul / choice / score questions",
  "documentationRef": "https://docs.typesafe.ai/api",
  "icon": {
    "contents": "data:image/webp;base64,"
  },
  "category": {
    "id": "connectors",
    "name": "Connectors"
  },
  "appliesTo": [
    "bpmn:Task"
  ],
  "elementType": {
    "value": "bpmn:ServiceTask"
  },
  "groups": [
    {
      "id": "authentication",
      "label": "Authentication"
    },
    {
      "id": "operation",
      "label": "Operation"
    },
    {
      "id": "payload",
      "label": "Payload"
    },
    {
      "id": "largeLists",
      "label": "Large lists (advanced)",
      "openByDefault": false
    },
    {
      "id": "output",
      "label": "Response mapping"
    },
    {
      "id": "error",
      "label": "Error handling"
    },
    {
      "id": "retries",
      "label": "Retries"
    }
  ],
  "properties": [
    {
      "type": "Hidden",
      "value": "io.github.rajeshponna:jev-ai-decision:1",
      "binding": {
        "type": "zeebe:taskDefinition",
        "property": "type"
      }
    },
    {
      "label": "TypeSafe API key",
      "group": "authentication",
      "type": "String",
      "feel": "optional",
      "value": "{{secrets.TYPESAFE_API_KEY}}",
      "description": "Store your key as a Camunda secret and reference it: {{secrets.TYPESAFE_API_KEY}}",
      "binding": {
        "type": "zeebe:input",
        "name": "apiKey"
      },
      "constraints": {
        "notEmpty": true
      }
    },
    {
      "label": "Organization ID",
      "group": "authentication",
      "type": "String",
      "feel": "optional",
      "optional": true,
      "description": "Optional. Your organization or team identifier, returned in the response for tracking",
      "binding": {
        "type": "zeebe:input",
        "name": "organizationId"
      }
    },
    {
      "label": "API endpoint",
      "group": "authentication",
      "type": "String",
      "feel": "optional",
      "value": "https://api.typesafe.ai",
      "description": "Change only for a proxy or private deployment",
      "binding": {
        "type": "zeebe:input",
        "name": "baseUrl"
      },
      "constraints": {
        "notEmpty": true
      }
    },
    {
      "id": "operation",
      "label": "Operation",
      "group": "operation",
      "type": "Dropdown",
      "value": "select",
      "choices": [
        {
          "name": "Choice: pick the best option",
          "value": "select"
        },
        {
          "name": "Noul: find all matching options",
          "value": "filter"
        },
        {
          "name": "Custom questions (noul / choice / score)",
          "value": "questions"
        }
      ],
      "binding": {
        "type": "zeebe:input",
        "name": "operation"
      }
    },
    {
      "id": "modelSelect",
      "label": "Model",
      "group": "payload",
      "type": "Dropdown",
      "value": "jev-latest",
      "choices": [
        {
          "name": "jev-latest (recommended)",
          "value": "jev-latest"
        },
        {
          "name": "Custom model",
          "value": "custom"
        }
      ],
      "binding": {
        "type": "zeebe:input",
        "name": "modelSelect"
      }
    },
    {
      "type": "Hidden",
      "value": "jev-latest",
      "binding": {
        "type": "zeebe:input",
        "name": "model"
      },
      "condition": {
        "property": "modelSelect",
        "equals": "jev-latest"
      }
    },
    {
      "label": "Custom model",
      "group": "payload",
      "type": "String",
      "description": "A pinned model, e.g. to keep results stable across releases",
      "binding": {
        "type": "zeebe:input",
        "name": "model"
      },
      "condition": {
        "property": "modelSelect",
        "equals": "custom"
      },
      "constraints": {
        "notEmpty": true
      }
    },
    {
      "label": "State",
      "group": "payload",
      "type": "Text",
      "feel": "required",
      "description": "What Jev evaluates, usually the user's request, e.g. =prompt",
      "binding": {
        "type": "zeebe:input",
        "name": "state"
      },
      "constraints": {
        "notEmpty": true
      }
    },
    {
      "label": "Options",
      "group": "payload",
      "type": "Text",
      "feel": "required",
      "value": "=books",
      "description": "List of any size. Each: {id, name, type?, description?}",
      "binding": {
        "type": "zeebe:input",
        "name": "items"
      },
      "condition": {
        "property": "operation",
        "oneOf": [
          "select",
          "filter"
        ]
      },
      "constraints": {
        "notEmpty": true
      }
    },
    {
      "label": "Instructions",
      "group": "payload",
      "type": "Text",
      "feel": "optional",
      "value": "Which option best fits this request?",
      "description": "The choice question Jev answers over your options",
      "binding": {
        "type": "zeebe:input",
        "name": "instructions"
      },
      "condition": {
        "property": "operation",
        "equals": "select"
      },
      "constraints": {
        "notEmpty": true
      }
    },
    {
      "label": "Instructions",
      "group": "payload",
      "type": "Text",
      "feel": "optional",
      "value": "Does `item` match what the user is asking for?",
      "description": "Yes/no question asked for every option. Refer to it as `item`",
      "binding": {
        "type": "zeebe:input",
        "name": "instructions"
      },
      "condition": {
        "property": "operation",
        "equals": "filter"
      },
      "constraints": {
        "notEmpty": true
      }
    },
    {
      "label": "Top N",
      "group": "payload",
      "type": "String",
      "feel": "optional",
      "value": "1",
      "description": "1 = best option only, 3 = top 3",
      "binding": {
        "type": "zeebe:input",
        "name": "topN"
      },
      "condition": {
        "property": "operation",
        "equals": "select"
      }
    },
    {
      "label": "Noul threshold",
      "group": "payload",
      "type": "String",
      "feel": "optional",
      "value": "0.5",
      "description": "Between 0 and 1. Options at or above this are returned",
      "binding": {
        "type": "zeebe:input",
        "name": "threshold"
      },
      "condition": {
        "property": "operation",
        "equals": "filter"
      }
    },
    {
      "label": "Max matches",
      "group": "payload",
      "type": "String",
      "feel": "optional",
      "optional": true,
      "description": "Optional cap, highest noul first",
      "binding": {
        "type": "zeebe:input",
        "name": "maxMatches"
      },
      "condition": {
        "property": "operation",
        "equals": "filter"
      }
    },
    {
      "label": "Questions",
      "group": "payload",
      "type": "Text",
      "feel": "required",
      "description": "questionId -> {type: noul | choice | score, instructions, criteria}. Choice max 255 options, score 2 to 10 levels",
      "value": "={department: {type: \"choice\", instructions: \"Which team should handle this?\", criteria: {billing: \"Payments, invoicing, refunds\", technical: \"Bugs, outages, integrations\", sales: \"Pricing, upgrades, new accounts\"}}, is_urgent: {type: \"noul\", instructions: \"Does this convey urgency?\"}}",
      "binding": {
        "type": "zeebe:input",
        "name": "questions"
      },
      "condition": {
        "property": "operation",
        "equals": "questions"
      },
      "constraints": {
        "notEmpty": true
      }
    },
    {
      "label": "Minimum confidence",
      "group": "payload",
      "type": "String",
      "feel": "optional",
      "value": "0.7",
      "description": "Between 0 and 1. Below this, needsReview = true",
      "binding": {
        "type": "zeebe:input",
        "name": "minConfidence"
      },
      "condition": {
        "property": "operation",
        "oneOf": [
          "select",
          "questions"
        ]
      }
    },
    {
      "label": "Group size",
      "group": "largeLists",
      "type": "String",
      "feel": "optional",
      "optional": true,
      "description": "Options per choice question (default 250, max 254)",
      "binding": {
        "type": "zeebe:input",
        "name": "groupSize"
      },
      "condition": {
        "property": "operation",
        "equals": "select"
      }
    },
    {
      "label": "Finalists per group",
      "group": "largeLists",
      "type": "String",
      "feel": "optional",
      "optional": true,
      "description": "Top K per group kept for the next round (default 3)",
      "binding": {
        "type": "zeebe:input",
        "name": "finalistsPerGroup"
      },
      "condition": {
        "property": "operation",
        "equals": "select"
      }
    },
    {
      "label": "Questions per API call",
      "group": "largeLists",
      "type": "String",
      "feel": "optional",
      "optional": true,
      "description": "Default 4 for choice, 50 for noul",
      "binding": {
        "type": "zeebe:input",
        "name": "questionsPerCall"
      },
      "condition": {
        "property": "operation",
        "oneOf": [
          "select",
          "filter"
        ]
      }
    },
    {
      "label": "Max tokens per API call",
      "group": "largeLists",
      "type": "String",
      "feel": "optional",
      "optional": true,
      "description": "Requests are split to stay under this (default 20000; Jev context is 32k)",
      "binding": {
        "type": "zeebe:input",
        "name": "maxTokensPerCall"
      },
      "condition": {
        "property": "operation",
        "oneOf": [
          "select",
          "filter"
        ]
      }
    },
    {
      "label": "Parallel API calls",
      "group": "largeLists",
      "type": "String",
      "feel": "optional",
      "optional": true,
      "description": "Default 4",
      "binding": {
        "type": "zeebe:input",
        "name": "maxConcurrentCalls"
      },
      "condition": {
        "property": "operation",
        "oneOf": [
          "select",
          "filter"
        ]
      }
    },
    {
      "label": "Max options",
      "group": "largeLists",
      "type": "String",
      "feel": "optional",
      "optional": true,
      "description": "Safety cap on list size (default 50000)",
      "binding": {
        "type": "zeebe:input",
        "name": "maxItems"
      },
      "condition": {
        "property": "operation",
        "oneOf": [
          "select",
          "filter"
        ]
      }
    },
    {
      "label": "Result variable",
      "group": "output",
      "type": "String",
      "value": "jev",
      "description": "Stores the full response, e.g. jev.selection.id",
      "binding": {
        "type": "zeebe:taskHeader",
        "key": "resultVariable"
      }
    },
    {
      "label": "Result expression",
      "group": "output",
      "type": "Text",
      "feel": "required",
      "optional": true,
      "description": "Optional, e.g. ={bookId: response.selection.id}",
      "binding": {
        "type": "zeebe:taskHeader",
        "key": "resultExpression"
      }
    },
    {
      "label": "Connection timeout",
      "group": "error",
      "type": "String",
      "feel": "optional",
      "value": "30",
      "description": "Seconds to wait for Jev before retrying",
      "binding": {
        "type": "zeebe:input",
        "name": "timeoutSeconds"
      }
    },
    {
      "label": "Error expression",
      "group": "error",
      "type": "Text",
      "feel": "required",
      "optional": true,
      "description": "Codes: JEV_UNAUTHORIZED, JEV_INVALID_REQUEST, JEV_INVALID_INPUT, JEV_ERROR",
      "binding": {
        "type": "zeebe:taskHeader",
        "key": "errorExpression"
      }
    },
    {
      "label": "Retries",
      "group": "retries",
      "type": "String",
      "feel": "optional",
      "value": "3",
      "binding": {
        "type": "zeebe:taskDefinition",
        "property": "retries"
      }
    },
    {
      "label": "Retry backoff",
      "group": "retries",
      "type": "String",
      "value": "PT10S",
      "description": "ISO-8601 duration between retries",
      "binding": {
        "type": "zeebe:taskHeader",
        "key": "retryBackoff"
      }
    }
  ]
}